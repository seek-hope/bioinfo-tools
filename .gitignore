# Build artefacts
/target/
**/target/

# Local oracle installs. The pins live in tests/ci/PINS.md and
# tests/ci/PINS-QC.md; the payloads are downloaded by a human or by CI
# provisioning and must never be committed. FastQC is ~15MB of class files plus
# JARs and the MultiQC virtualenv is ~1.1GB, so ignoring the whole tree is the
# only workable rule; the tracked pin notes live alongside it in tests/ci/.
tests/ci/env/

# Scratch space used during development.
.work/
/gg.fa

# CodeGraph index (local machine state; has its own internal .gitignore).
.codegraph/


# Trial harness/config directories, not project source.
/AGENTS.md
/TASK.md
/.pi/
/.leader-verify/

# Python bytecode/
__pycache__/
*.pyc
